<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:background="@color/widget_background">
<TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ADV Ride Helper" android:textColor="@color/widget_text" android:textSize="14sp" android:maxLines="1" />
<TextView android:id="@+id/widget_fuel" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:text="Fuel / range" android:textColor="@color/widget_text" android:textSize="22sp" android:textStyle="bold" android:maxLines="2" />
<TextView android:id="@+id/widget_front" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Front: waiting" android:textColor="@color/widget_text" android:textSize="16sp" android:maxLines="2" />
<TextView android:id="@+id/widget_rear" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Rear: waiting" android:textColor="@color/widget_text" android:textSize="16sp" android:maxLines="2" />
<TextView android:id="@+id/widget_updated" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Updated when data arrives" android:textColor="@color/widget_text" android:textSize="12sp" android:maxLines="1" />
</LinearLayout>